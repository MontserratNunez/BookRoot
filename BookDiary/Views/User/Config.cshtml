@{
    ViewData["Title"] = "Configuración de la Cuenta";
}

<style>
    .config-card {
        background-color: #ffffff;
        border: 1px solid var(--br-border, #e0d8cf);
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(43, 38, 35, 0.04);
    }

    .danger-card {
        border: 1px solid #f5c2c7;
        background-color: #fffdfd;
        border-radius: 12px;
        box-shadow: 0 4px 16px rgba(220, 53, 69, 0.04);
    }
</style>

<div class="py-4" style="max-width: 650px; margin: 0 auto;">

    <div class="text-center mb-4">
        <h1 class="display-6 font-serif fw-bold mb-2" style="color: var(--br-ink);">Configuración</h1>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 8px;">
            <i class="bi bi-check-circle-fill flex-shrink-0 fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="config-card p-4 p-md-5 mb-4">
        <div class="d-flex align-items-center gap-2 pb-3 mb-4 border-bottom" style="border-color: var(--br-border) !important;">
            <i class="bi bi-shield-lock-fill text-amber fs-5"></i>
            <h2 class="h5 font-serif fw-bold mb-0 text-dark">Seguridad y Acceso</h2>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div>
                <h3 class="h6 font-serif fw-bold mb-1 text-dark">Contraseña de acceso</h3>
            </div>
            <a asp-action="ChangePassword" id="ChangePassword" class="btn btn-outline-secondary fw-semibold px-3 py-2 flex-shrink-0" style="border-color: var(--br-border); color: var(--br-ink);">
                <i class="bi bi-key me-1"></i> Cambiar contraseña
            </a>
        </div>
    </div>

    <div class="danger-card p-4 p-md-5 mb-5">
        <div class="d-flex align-items-center gap-2 pb-3 mb-4 border-bottom border-danger-subtle">
            <i class="bi bi-exclamation-octagon-fill text-danger fs-5"></i>
            <h2 class="h5 font-serif fw-bold mb-0 text-danger">Zona de Peligro</h2>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div>
                <h3 class="h6 font-serif fw-bold mb-1 text-danger">Eliminar cuenta</h3>
                <p class="text-muted small mb-0">Esta acción eliminará de forma permanente tu perfil, lecturas, listas y datos guardados.</p>
            </div>
            <form asp-controller="User" asp-action="DeleteAccount" method="post" id="deleteAccountForm" class="m-0 flex-shrink-0">
                <button type="submit" id="DeleteProfile" class="btn btn-danger fw-semibold px-3 py-2">
                    <i class="bi bi-trash3 me-1"></i> Borrar cuenta
                </button>
            </form>
        </div>
    </div>

    <div class="text-center pt-2">
        <a asp-controller="User" asp-action="Profile" class="btn-br-ghost">
            <i class="bi bi-arrow-left me-2"></i> Volver al perfil
        </a>
    </div>

</div>

@section Scripts {
    <script nonce="@Context.Items["csp-nonce"]">
        document.addEventListener('DOMContentLoaded', () => {
            const deleteForm = document.getElementById('deleteAccountForm');
            if (deleteForm) {
                deleteForm.addEventListener('submit', (e) => {
                    if (!confirm('¿Estás seguro de que quieres eliminar tu cuenta permanentemente? Esta acción borrará todas tus lecturas, listas y no se puede deshacer.')) {
                        e.preventDefault();
                    }
                });
            }
        });
    </script>
}