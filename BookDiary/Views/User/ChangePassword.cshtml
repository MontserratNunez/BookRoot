@model Application.ViewModels.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            
            <div class="p-4 p-md-5 rounded shadow-sm position-relative"
                 style="background: #fdfbf7; border: 1px solid var(--br-border, #f2e9d8);">
                
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-10">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                         style="width: 52px; height: 52px; background: rgba(200, 125, 85, 0.12); color: var(--br-amber, #c87d55);">
                        <i class="bi bi-shield-lock-fill fs-4"></i>
                    </div>
                    <div>
                        <h1 class="h4 font-serif fw-bold text-dark mb-1">Cambiar Contraseña</h1>
                        <p class="text-muted small mb-0">Actualiza las credenciales de acceso de tu cuenta.</p>
                    </div>
                </div>

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label text-dark fw-medium small mb-1">Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0" placeholder="" />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label text-dark fw-medium small mb-1">Confirmar Nueva Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="bi bi-lock-fill"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top border-secondary border-opacity-10">
                        <a asp-action="Config" class="btn btn-outline-secondary fw-semibold px-3 py-2">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-amber text-white fw-semibold px-4 py-2 shadow-sm d-flex align-items-center gap-2" style="background-color: var(--br-amber, #c87d55); border: none;">
                            <i class="bi bi-check-circle-fill small"></i>
                            <span>Actualizar Contraseña</span>
                        </button>
                    </div>
                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}