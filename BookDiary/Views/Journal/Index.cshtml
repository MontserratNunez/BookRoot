@using Application.ViewModels.Journal

@model JournalViewModel

<div class="container" style="max-width: 700px; margin-top: 30px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
    
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 pb-4 border-bottom" style="border-color: var(--br-border) !important;">
        <div>
            <h2 class="display-6 font-serif fw-bold mb-1" style="color: var(--br-ink);">Diario de Lectura</h2>
        </div>
        <button type="button" id="btnExportJournal" class="btn btn-br-ghost fw-semibold px-3 py-2 flex-shrink-0" title="Descargar como HTML estilizado">
            <i class="bi bi-download me-1 text-amber"></i> Exportar Diario
        </button>
        
    </div>

    <div id="exportModal" style="display:none; position: fixed; z-index: 1050; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5);">
        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 30px; border-radius: 8px; width: 400px; box-shadow: 0px 4px 15px rgba(0,0,0,0.3);">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="margin-top: 0; margin-bottom: 15px;">Exportar Diario de Lectura</h5>
                </div>
                
                <form asp-controller="Journal" asp-action="ExportDiary" method="get">
                    <div class="modal-body">

                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display: block; margin-bottom: 5px; font-weight: 600;">Diseño del Diario:</label>
                            <select name="theme" id="exportTheme" class="form-control" style="width: 100%; padding: 6px;">
                                <option value="floral">Floral</option>
                                <option value="space">Espacio</option>
                                <option value="manuscript">Manuscrito</option>
                            </select>
                        </div>

                        <div class="form-group" style="margin-bottom: 15px;">
                            <label style="display: block; margin-bottom: 5px;">Período:</label>
                            <select name="filter" id="exportFilter" class="form-control" style="width: 100%; padding: 6px;">
                                <option value="all">Todo el tiempo</option>
                                <option value="last_month">Último mes</option>
                                <option value="last_year">Último año</option>
                                <option value="custom">Personalizado</option>
                            </select>
                        </div>
                        
                        <div id="customDatesContainer" style="display: none; margin-bottom: 15px;">
                            <div style="display: flex; gap: 10px;">
                                <div style="flex: 1;">
                                    <label style="font-size: 13px;">Desde:</label>
                                    <input type="date" name="from" class="form-control" style="width: 100%; padding: 4px;" />
                                </div>
                                <div style="flex: 1;">
                                    <label style="font-size: 13px;">Hasta:</label>
                                    <input type="date" name="to" class="form-control" style="width: 100%; padding: 4px;" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer" style="margin-top: 20px; text-align: right;">
                        <button type="button" class="js-close-export-modal btn btn-outline-secondary btn-sm fw-semibold px-3">Cancelar</button>
                        <button type="submit" class="js-close-export-modal btn text-white btn-sm fw-semibold px-3" style="background-color: var(--br-amber, #c87d55); border: none;">
                            <i class="bi bi-file-earmark-code me-1"></i> Exportar HTML
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <script nonce="@Context.Items["csp-nonce"]">
        document.addEventListener('DOMContentLoaded', () => {
            const btnExport = document.getElementById('btnExportJournal');
            const exportModal = document.getElementById('exportModal');
            const exportFilter = document.getElementById('exportFilter');
            const customDatesContainer = document.getElementById('customDatesContainer');
            const closeBtns = document.querySelectorAll('.js-close-export-modal');

            if (btnExport && exportModal) {
                btnExport.addEventListener('click', () => {
                    exportModal.style.display = 'block';
                });
            }

            if (closeBtns.length > 0 && exportModal) {
                closeBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        exportModal.style.display = 'none';
                    });
                });
            }

            if (exportFilter && customDatesContainer) {
                exportFilter.addEventListener('change', () => {
                    customDatesContainer.style.display = (exportFilter.value === 'custom') ? 'block' : 'none';
                });
            }
        });
    </script>

    @if (Model.Years == null || !Model.Years.Any())
    {
        <p class="text-muted" style="font-style: italic;">No hay registros de lecturas con fechas válidas en el historial.</p>
    }
    else
    {
        @foreach (var yearGroup in Model.Years)
        {
            <div class="year-block" style="margin-bottom: 40px;">
                <h1 style="color: #2c3e50; font-weight: 800; margin-bottom: 15px; font-size: 2.5rem;">
                    @yearGroup.Year
                </h1>

                @foreach (var monthGroup in yearGroup.Months)
                {
                    <div class="month-block" style="margin-left: 20px; margin-bottom: 25px; border-left: 3px solid #3498db; padding-left: 15px;">
                        <h4 style="color: #34495e; font-weight: 600; text-transform: capitalize; margin-bottom: 15px;">
                            @monthGroup.MonthName
                        </h4>

                        <div class="books-list" style="display: flex; flex-direction: column; gap: 12px;">
                            @foreach (var libro in monthGroup.Books)
                            {
                                <div class="book-journal-item" style="display: flex; align-items: center; justify-content: space-between; background: #fff; padding: 10px 15px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
                                    <div style="display: flex; align-items: center; gap: 15px;">
                                        <span class="badge-day" style="background: #e74c3c; color: white; font-weight: bold; padding: 5px 8px; border-radius: 4px; font-size: 0.9rem;">
                                            @libro.FinishedDay
                                        </span>
                                        
                                        @if (!string.IsNullOrEmpty(libro.CoverUrl))
                                        {
                                            <img src="@libro.CoverUrl" alt="Portada" style="width: 35px; height: 50px; object-fit: cover; border-radius: 3px; box-shadow: 1px 1px 3px rgba(0,0,0,0.1);" />
                                        }

                                        <div>
                                            <a asp-controller="Book" asp-action="Details" asp-route-bookWorkKey="@libro.BookWorkKey" style="text-decoration: none; color: #2980b9; font-weight: 600; font-size: 1.05rem;">
                                                @libro.Title
                                            </a>
                                            <span style="display: block; font-size: 0.85rem; color: #7f8c8d;">por @libro.Author</span>
                                        </div>
                                    </div>

                                    @if (libro.Rating.HasValue && libro.Rating.Value > 0)
                                    {
                                        <div style="color: #f1c40f; font-size: 1.1rem;">
                                            @string.Concat(Enumerable.Repeat("★", libro.Rating.Value))<span style="color: #e0e0e0;">@string.Concat(Enumerable.Repeat("★", 5 - libro.Rating.Value))</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>
