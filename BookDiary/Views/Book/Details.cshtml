@model BookDetailsViewModel
@using Domain.Enums

<div class="container my-5" id="bookDetailsContainer" data-book-key="@Model.BookWorkKey" data-book-title="@Model.Title">
    @Html.AntiForgeryToken()

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-dismissible fade show border-0 rounded-3 mb-4 shadow-sm p-3 d-flex align-items-center gap-2"
             style="background-color: var(--br-amber-pale); color: var(--br-forest); border-left: 4px solid var(--br-forest) !important;" role="alert">
            <i class="bi bi-check-circle-fill text-success fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-dismissible fade show border-0 rounded-3 mb-4 shadow-sm p-3 d-flex align-items-center gap-2"
             style="background-color: #fce8e6; color: #a82218; border-left: 4px solid #a82218 !important;" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="bg-cream rounded-4 shadow-sm p-4 p-md-5 mb-5 position-relative" style="border: 1px solid var(--br-border);">
        <div class="row g-4 g-lg-5 align-items-start">

            <div class="col-12 col-md-5 col-lg-4 text-center">
                <div class="br-book-wrapper mx-auto" style="max-width: 270px; height: 380px;">
                    @if (!string.IsNullOrEmpty(Model.CoverEditionKey))
                    {
                        <img src="@Model.CoverEditionKey"
                             alt="Portada de @Model.Title"
                             class="w-100 h-100"
                             style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="br-book-cover cover-style-2">
                            <div>
                                <span class="badge bg-amber-pale text-amber border border-warning rounded-pill mb-2">BookRoot</span>
                                <h2 class="br-book-title mt-2">@Model.Title</h2>
                                <p class="br-book-author">@Model.Author</p>
                            </div>
                            <div class="text-end opacity-50 fs-2">✦</div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-md-7 col-lg-8 d-flex flex-column justify-content-between h-100">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                        <span class="badge bg-forest text-paper px-3 py-2 font-monospace fs-6 rounded-1 shadow-sm">
                            <i class="bi bi-key-fill text-amber me-1"></i> Work Key: <strong>@Model.BookWorkKey</strong>
                        </span>
                    </div>

                    <h2 class="font-serif fw-bold mb-2" style="color: var(--br-ink);">@Model.Title</h2>
                    <p class="fs-6 text-muted-br mb-4">Por <span class="fw-semibold" style="color: var(--br-ink);">@Model.Author</span></p>

                    <div class="d-inline-flex align-items-center gap-3 bg-amber-pale px-3 py-2 rounded-3 mb-4" style="border: 1px solid var(--br-border);">
                        <span class="br-rating-stars fs-3">★</span>
                        <div>
                            @if (Model.AverageRating == null)
                            {
                                <span class="text-muted-br fw-medium">Sin calificaciones aún</span>
                            }
                            else
                            {
                                <span class="fw-bold fs-4" style="color: var(--br-ink);">@Model.AverageRating?.ToString("0.0")</span>
                                <span class="text-muted-br fs-6">/ 5.0</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="pt-4 mt-2" style="border-top: 1px solid var(--br-border);">
                    <label class="form-label text-uppercase text-muted-br fw-bold fs-7 mb-3 d-block" style="letter-spacing: 0.08em;">
                        Gestión de lectura
                    </label>

                    <div class="d-flex flex-wrap gap-3 align-items-center">
                        @if (Model.IsCompleted)
                        {
                            <button type="button" class="btn-br-forest js-open-modal-completado">
                                <i class="bi bi-check-circle-fill"></i> Leído
                            </button>

                            <form asp-controller="Interaction" asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.IntId" />
                                <input type="hidden" name="bookKey" value="@Model.BookWorkKey" />
                                <button class="btn-br-danger" type="submit">
                                    <i class="bi bi-trash"></i> Eliminar
                                </button>
                            </form>
                        }
                        else if (Model.IsInReading)
                        {
                            <button type="button" class="btn-br-forest-outline js-open-modal-completado">
                                <i class="bi bi-check2-circle"></i> Marcar como Leído
                            </button>

                            <form asp-controller="Interaction" asp-action="Delete" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@Model.IntId" />
                                <input type="hidden" name="bookKey" value="@Model.BookWorkKey" />
                                <button class="btn-br-amber" type="submit" title="Haz clic para quitar de pendientes">
                                    <i class="bi bi-bookmark-check-fill"></i> En pendientes
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn-br-forest-outline js-open-modal-completado">
                                <i class="bi bi-check-lg"></i> Marcar como Leído
                            </button>

                            <form asp-controller="Interaction" asp-action="Add" method="post" class="d-inline">
                                <input type="hidden" name="Status" value="@InteractionStatus.reading" />
                                <input type="hidden" name="Query" value="@ViewBag.Query" />
                                <input type="hidden" name="BookWorkKey" value="@Model.BookWorkKey" />
                                <button type="submit" class="btn-br-amber-outline">
                                    <i class="bi bi-bookmark-plus"></i> Agregar a pendiente
                                </button>
                            </form>
                        }

                        <button type="button" class="btn-br-ghost ms-md-auto js-open-modal-listas">
                            <i class="bi bi-plus-circle"></i> Agregar a Lista
                        </button>
                    </div>

                    <div class="mt-3 pt-3" style="border-top: 1px solid var(--br-border);">
                        @if (Model.IsFavorite)
                        {
                            <button type="button" class="btn-br-fav-active js-open-modal-quitar-favorito">
                                <i class="bi bi-heart-fill"></i> En tus favoritos
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-br-fav js-open-modal-favoritos">
                                <i class="bi bi-heart"></i> Agregar a favoritos
                            </button>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div id="completadoModal" style="display:none; position: fixed; z-index: 1050; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);" class="fade show">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 440px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h4 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Finalizar Lectura</h4>
                <p class="text-muted-br small mb-0 text-truncate">@Model.Title</p>
            </div>

            <form asp-controller="Interaction" asp-action="Add" method="post">
                <div class="bg-cream p-4">
                    <input type="hidden" name="BookWorkKey" value="@Model.BookWorkKey" />
                    <input type="hidden" name="Query" value="@ViewBag.Query" />
                    <input type="hidden" name="Status" value="@InteractionStatus.completed" />

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted-br">Fecha en que lo terminaste (Opcional):</label>
                        <input type="date" id="modalFinishedAt" name="FinishedAt" class="form-control bg-amber-pale rounded-2"
                               style="border: 1px solid var(--br-border); color: var(--br-ink);"
                               value="@(Model.SelfFinished?.ToString("yyyy-MM-dd"))" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold text-muted-br d-block">Tu Calificación (Opcional):</label>
                        <input type="hidden" id="modalRating" name="Rating" value="@(Model.SelfRating ?? 0)" />

                        <div class="star-rating d-flex gap-2 fs-2 cursor-pointer user-select-none">
                            <span class="star js-star" data-value="1" style="color: var(--br-border); cursor: pointer; transition: color 0.2s;">★</span>
                            <span class="star js-star" data-value="2" style="color: var(--br-border); cursor: pointer; transition: color 0.2s;">★</span>
                            <span class="star js-star" data-value="3" style="color: var(--br-border); cursor: pointer; transition: color 0.2s;">★</span>
                            <span class="star js-star" data-value="4" style="color: var(--br-border); cursor: pointer; transition: color 0.2s;">★</span>
                            <span class="star js-star" data-value="5" style="color: var(--br-border); cursor: pointer; transition: color 0.2s;">★</span>
                        </div>
                    </div>
                </div>
                <div class="bg-cream p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--br-border);">
                    <button type="button" class="btn-br-ghost js-close-modal-completado">Cancelar</button>
                    <button type="submit" class="btn-br-primary">Guardar Registro</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="listasModal" style="display:none; position: fixed; z-index: 1050; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);" class="fade show">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 440px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h4 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Añadir a una Lista</h4>
                <p class="text-muted-br small mb-0 text-truncate">@Model.Title</p>
            </div>

            <div class="bg-cream p-3" style="max-height: 320px; overflow-y: auto;" id="listasContainer">
                <div class="text-center text-muted py-3">
                    <div class="spinner-border spinner-border-sm text-amber me-2" role="status"></div>
                    Cargando listas...
                </div>
            </div>
            <div class="bg-cream p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--br-border);">
                <button type="button" class="btn-br-ghost js-close-modal-listas">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div id="quitarDeListaModal" style="display:none; position: fixed; z-index: 1100; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 400px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h5 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Quitar de la lista</h5>
                <p class="text-muted-br small mb-0" id="quitarDeListaMensaje"></p>
            </div>
            <form id="quitarDeListaForm" method="post">
                <input type="hidden" name="listId" id="quitarListaId" />
                <input type="hidden" name="bookWorkKey" value="@Model.BookWorkKey" />
                <input type="hidden" name="returnBookKey" value="@Model.BookWorkKey" />
                <div class="bg-cream p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--br-border);">
                    <button type="button" class="btn-br-ghost js-close-modal-quitar-lista">Cancelar</button>
                    <button type="submit" class="btn-br-danger">
                        <i class="bi bi-trash me-1"></i>Quitar libro
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="favoritosModal" style="display:none; position: fixed; z-index: 1050; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 480px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h4 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Agregar a favoritos</h4>
                <p class="text-muted-br small mb-0 text-truncate">Selecciona dónde colocar: <strong>@Model.Title</strong></p>
            </div>

            <div class="bg-cream p-4">
                <div class="d-flex gap-3 justify-content-center" id="favoritosSlots" style="min-height: 120px;">
                    <div class="text-center text-muted py-3 w-100">
                        <div class="spinner-border spinner-border-sm text-amber me-2" role="status"></div>
                        Cargando...
                    </div>
                </div>
            </div>
            <div class="bg-cream p-3 d-flex justify-content-end" style="border-top: 1px solid var(--br-border);">
                <button type="button" class="btn-br-ghost js-close-modal-favoritos">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div id="reemplazarFavModal" style="display:none; position: fixed; z-index: 1100; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 400px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h5 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Reemplazar favorito</h5>
                <p class="text-muted-br small mb-0" id="reemplazarFavMensaje"></p>
            </div>
            <form id="reemplazarFavForm" asp-controller="User" asp-action="AddToFavorites" method="post">
                <input type="hidden" name="bookWorkKey" value="@Model.BookWorkKey" />
                <input type="hidden" name="returnBookKey" value="@Model.BookWorkKey" />
                <input type="hidden" name="slotIndex" id="reemplazarFavSlot" />
                <div class="bg-cream p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--br-border);">
                    <button type="button" class="btn-br-ghost js-close-modal-reemplazar">Cancelar</button>
                    <button type="submit" class="btn-br-primary">Reemplazar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="quitarFavModal" style="display:none; position: fixed; z-index: 1050; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(26, 18, 8, 0.6);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 90%; max-width: 400px;">
        <div class="bg-paper border-0 shadow-lg rounded-4 overflow-hidden" style="border: 1px solid var(--br-border) !important;">
            <div class="bg-cream pt-4 px-4 pb-3" style="border-bottom: 1px solid var(--br-border);">
                <h5 class="font-serif fw-bold mb-1" style="color: var(--br-ink);">Quitar de favoritos</h5>
                <p class="text-muted-br small mb-0">¿Quieres quitar <strong>@Model.Title</strong> de tus favoritos?</p>
            </div>
            <form asp-controller="User" asp-action="RemoveFromFavorites" method="post">
                <input type="hidden" name="bookWorkKey" value="@Model.BookWorkKey" />
                <input type="hidden" name="returnBookKey" value="@Model.BookWorkKey" />
                <div class="bg-cream p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--br-border);">
                    <button type="button" class="btn-br-ghost js-close-modal-quitar-favorito">Cancelar</button>
                    <button type="submit" class="btn-br-danger">
                        <i class="bi bi-heart-break me-1"></i>Sí, quitar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.Items["CSP-Nonce"]" src="~/js/book-details.js" asp-append-version="true"></script>
}


<style>
