        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--br-forest);
        border-radius: 2px;
        transition: all 0.25s ease;
    }

        .btn-br-forest-outline:hover {
            background: var(--br-forest);
            color: var(--br-paper) !important;
            transform: translateY(-2px);
        }

    .btn-br-amber {
        display: inline-flex;
        align-items: center;
