        align-items: center;
        gap: 0.5rem;
        background: var(--br-forest);
        color: var(--br-paper) !important;
        padding: 0.8rem 1.8rem;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        text-decoration: none;
        border-radius: 2px;
        border: 1px solid var(--br-forest);
        transition: all 0.25s ease;
    }

        .btn-br-forest:hover {
            background: #1e331e;
            border-color: #1e331e;
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(45, 74, 45, 0.25);
        }

    .btn-br-forest-outline {
