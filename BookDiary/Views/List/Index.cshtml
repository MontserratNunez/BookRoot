@using Application.ViewModels.Lists
@model ListIndexViewModel
@{
    ViewData["Title"] = $"Listas de @{Model.Username}";
}

<style>
    .list-card-item {
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

    .list-card-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(43, 38, 35, 0.08) !important;
        border-color: var(--br-amber, #c87d55) !important;
    }

    .list-card-item:hover .list-title-link {
        color: var(--br-amber, #c87d55) !important;
    }

    .list-title-link {
        transition: color 0.2s ease;
    }
</style>

<div class="py-4" style="max-width: 950px; margin: 0 auto;">

    <div class="mb-3 pb-4 border-bottom" style="border-color: var(--br-border) !important;">

        <div class="d-inline-flex align-items-center gap-2 mb-2 text-uppercase font-weight-500 text-amber small" style="letter-spacing: 0.12em;">
            <i class="bi bi-collection"></i>
            Colecciones
        </div>

        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-1">
            <h1 class="display-6 font-serif fw-bold mb-0" style="color: var(--br-ink);">Listas de @Model.Username</h1>

            @if (Model.IsOwner)
            {
                <a asp-action="Create" class="btn text-white fw-semibold px-4 py-2" style="background-color: var(--br-amber, #c87d55); border: none;">
                    <i class="bi bi-plus-lg me-1"></i> Crear nueva lista
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 8px;">
            <i class="bi bi-check-circle-fill flex-shrink-0 fs-5"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4 shadow-sm" role="alert" style="border-radius: 8px;">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Lists == null || !Model.Lists.Any())
    {
        <div class="p-5 text-center bg-white rounded shadow-sm mb-5" style="border: 1px solid var(--br-border);">
            <div class="d-inline-flex align-items-center justify-content-center bg-light rounded-circle mb-3" style="width: 70px; height: 70px; border: 1px solid var(--br-border);">
                <i class="bi bi-journal-bookmark fs-2 text-amber"></i>
            </div>
            <h2 class="h5 font-serif fw-bold text-dark mb-2">Sin listas creadas</h2>
            <p class="text-muted mb-4 mx-auto" style="max-width: 420px;">
                @(Model.IsOwner ? "Aún no has creado ninguna lista. ¡Comienza una para agrupar tus lecturas favoritas!" : $"@{Model.Username} aún no ha compartido ninguna lista de lectura.")
            </p>
            @if (Model.IsOwner)
            {
                <a asp-action="Create" class="btn text-white fw-semibold px-4" style="background-color: var(--br-amber, #c87d55); border: none;">
                    <i class="bi bi-plus-lg me-1"></i> Crear mi primera lista
                </a>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3 mb-5">
            @foreach (var list in Model.Lists)
            {
                <div class="card bg-white border-0 shadow-sm rounded p-4 list-card-item" style="border: 1px solid var(--br-border) !important;">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        
                        <div class="flex-grow-1 min-w-0">
                            <h2 class="h5 font-serif fw-bold mb-1 text-truncate">
                                <a asp-action="Details" asp-route-listId="@list.Id" class="text-dark text-decoration-none list-title-link">
                                    @list.ListName
                                </a>
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(list.ListDescription))
                            {
                                <p class="text-muted mb-2 small text-truncate" style="max-width: 650px; line-height: 1.5;">
                                    @list.ListDescription
                                </p>
                            }

                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mt-2">
                                <span class="badge bg-light text-dark border fw-normal px-2 py-1" style="border-color: var(--br-border) !important;">
                                    <i class="bi bi-book text-amber me-1"></i> @list.BookCount @(list.BookCount == 1 ? "libro" : "libros")
                                </span>
                                @if (list.CreatedAt.HasValue)
                                {
                                    <span>
                                        <i class="bi bi-calendar3 me-1"></i> Creada el @list.CreatedAt.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 flex-shrink-0 align-self-end align-self-md-center">
                            <a asp-action="Details" asp-route-listId="@list.Id" class="btn btn-sm btn-outline-secondary fw-semibold px-3" style="border-color: var(--br-border); color: var(--br-ink);">
                                Ver lista <i class="bi bi-chevron-right ms-1"></i>
                            </a>

                            @if (Model.IsOwner)
                            {
                                <form asp-action="Delete" method="post" class="js-delete-list-form d-inline m-0">
                                    <input type="hidden" name="listId" value="@list.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-2" title="Eliminar lista">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center pt-2">
        <a asp-controller="User" asp-action="Profile" asp-route-username="@Model.Username" class="btn-br-ghost">
            <i class="bi bi-arrow-left me-2"></i> Volver al perfil
        </a>
    </div>

</div>

@section Scripts {
    <script nonce="@Context.Items["csp-nonce"]">
        document.addEventListener('DOMContentLoaded', () => {
            document.body.addEventListener('submit', (e) => {
                if (e.target.matches('.js-delete-list-form')) {
                    if (!confirm('¿Estás seguro de que deseas eliminar esta lista?')) {
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
}