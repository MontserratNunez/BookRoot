@model Application.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_LayoutAnonymous";
}

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: calc(100vh - 120px);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
                
                <div class="p-4 p-md-5 rounded shadow-sm text-center position-relative"
                     style="background: #fdfbf7; border: 1px solid var(--br-border, #f2e9d8);">
                    
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 64px; height: 64px; background: rgba(200, 125, 85, 0.12); color: var(--br-amber, #c87d55);">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>

                    <h1 class="h3 font-serif fw-bold text-dark mb-2">Nueva Contraseña</h1>
                    <p class="text-muted small mb-4">
                        Ingresa y confirma tu nueva contraseña para actualizar las credenciales de tu cuenta.
                    </p>

                    <form asp-action="ResetPassword" method="post" class="text-start">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small rounded mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label text-dark fw-medium small mb-1">Nueva Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="NewPassword" type="password" class="form-control border-start-0 ps-0" placeholder="" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label text-dark fw-medium small mb-1">Confirmar Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white text-muted border-end-0">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        <button type="submit" class="btn btn-amber text-white fw-semibold w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: var(--br-amber, #c87d55); border: none;">
                            <span>Actualizar Contraseña</span>
                            <i class="bi bi-check-circle-fill small"></i>
                        </button>
                    </form>

                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-10 text-center">
                        <a asp-action="Login" class="text-decoration-none small text-muted fw-medium d-inline-flex align-items-center gap-1">
                            <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}