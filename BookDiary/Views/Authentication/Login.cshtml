@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutAnonymous";
}

<section class="py-5 min-vh-100 d-flex align-items-center" style="background: var(--br-cream);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="p-4 p-md-5 rounded shadow-sm bg-white" style="border: 1px solid var(--br-border);">

                    <div class="text-center mb-4">
                        <span class="text-amber text-uppercase small font-weight-600" style="letter-spacing: 0.12em;">Bienvenido de nuevo</span>
                        <h2 class="display-6 font-serif fw-bold mt-1">Iniciar Sesión</h2>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success small py-2 mb-4">
                            @TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger small py-2 mb-4">
                            @TempData["ErrorMessage"]
                        </div>
                    }

                    <form asp-action="Login" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label font-weight-500 small text-uppercase text-muted" style="letter-spacing: 0.05em;">Correo Electrónico</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="tu@email.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label font-weight-500 small text-uppercase text-muted" style="letter-spacing: 0.05em;">Contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 text-muted">
                                    <i class="bi bi-lock"></i>
                                </span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        </div>
                        
                        <div class="mb-4 text-end">
                            <a asp-controller="Authentication" asp-action="ForgotPassword" class="small text-muted text-decoration-none">¿Olvidaste tu contraseña?</a>
                        </div>

                        <button type="submit" class="btn-br-primary w-100 py-2.5 mb-3">
                            Acceder <i class="bi bi-box-arrow-in-right ms-1"></i>
                        </button>

                        <div class="text-center pt-3 border-top border-opacity-10 border-dark">
                            <span class="small text-muted-br">¿Aún no tienes cuenta?</span>
                            <a asp-controller="Authentication" asp-action="SignUp" class="small fw-bold text-amber ms-1 text-decoration-none">
                                Crear cuenta
                            </a>
                        </div>
                        
                        <div class="text-center pt-2">
                            <a asp-controller="Authentication" asp-action="ResendConfirmation" class="small text-muted text-decoration-none">Reenviar correo de confirmación</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}