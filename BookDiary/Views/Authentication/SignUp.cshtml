@model SignUpViewModel
@{
    ViewData["Title"] = "Crear Cuenta";
    Layout = "_LayoutAnonymous";
}

<section class="py-5 min-vh-100 d-flex align-items-center" style="background: var(--br-cream);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">
                <div class="p-4 p-md-5 rounded shadow-sm bg-white" style="border: 1px solid var(--br-border);">

                    <div class="text-center mb-4">
                        <span class="text-amber text-uppercase small font-weight-600" style="letter-spacing: 0.12em;">Únete a BookRoot</span>
                        <h2 class="display-6 font-serif fw-bold mt-1">Crear Cuenta</h2>
                    </div>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-3" role="alert">
                            @Html.ValidationSummary(false, "", new { @class = "mb-0 text-danger list-unstyled" })
                        </div>
                    }

                    <form asp-action="SignUp" method="post" novalidate>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Username" class="form-label font-weight-500 small text-uppercase text-muted" style="letter-spacing: 0.05em;">Nombre de Usuario</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                                        <i class="bi bi-person"></i>
                                    </span>
                                    <input asp-for="Username" class="form-control border-start-0 ps-0" />
                                </div>
                                <span asp-validation-for="Username" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label font-weight-500 small text-uppercase text-muted" style="letter-spacing: 0.05em;">Correo Electrónico</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input asp-for="Email" class="form-control border-start-0 ps-0"/>
                                </div>
                                <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Password" class="form-label font-weight-500 small text-uppercase text-muted" style="letter-spacing: 0.05em;">Contraseña</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-transparent border-end-0 text-muted">
                                        <i class="bi bi-lock"></i>
                                    </span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12 mt-4">
                                <button type="submit" class="btn-br-primary w-100 py-2.5 mb-3">
                                    Crear mi cuenta <i class="bi bi-person-plus ms-1"></i>
                                </button>
                            </div>
                        </div>

                        <div class="text-center pt-3 border-top border-opacity-10 border-dark">
                            <span class="small text-muted-br">¿Ya tienes una cuenta?</span>
                            <a asp-controller="Authentication" asp-action="Login" class="small fw-bold text-amber ms-1 text-decoration-none">
                                Iniciar Sesión
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}