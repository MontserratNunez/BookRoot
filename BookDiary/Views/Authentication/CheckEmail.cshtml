@{
    ViewData["Title"] = "Confirma tu correo";
    Layout = "_LayoutAnonymous";
}

<div class="d-flex align-items-center justify-content-center py-5" style="min-height: calc(100vh - 120px);">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
                
                <div class="p-4 p-md-5 rounded shadow-sm text-center position-relative"
                     style="background: #fdfbf7; border: 1px solid var(--br-border, #f2e9d8);">
                    
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                         style="width: 64px; height: 64px; background: rgba(200, 125, 85, 0.12); color: var(--br-amber, #c87d55);">
                        <i class="bi bi-envelope-check-fill fs-3"></i>
                    </div>

                    <h1 class="h3 font-serif fw-bold text-dark mb-2">Confirma tu correo</h1>
                    <p class="text-muted small mb-4">
                        Te hemos enviado un correo de confirmación. Por favor, haz clic en el enlace recibido antes de iniciar sesión.
                    </p>

                    <a asp-controller="Authentication" asp-action="Login"
                           class="btn btn-amber text-white fw-semibold w-100 py-2 shadow-sm d-flex align-items-center justify-content-center gap-2 mb-3"
                           style="background-color: var(--br-amber, #c87d55); border: none;">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Ir al inicio de sesión</span>
                    </a>

                    <div class="pt-3 border-top border-secondary border-opacity-10 text-center">
                        <span class="text-muted small">¿No recibiste el correo?</span>
                        <a asp-controller="Authentication" asp-action="ResendConfirmation"
                               class="text-decoration-none small fw-semibold ms-1"
                               style="color: var(--br-amber, #c87d55);">
                            Reenviar activación
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
